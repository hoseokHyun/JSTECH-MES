# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public App Production URL: The production base URL used for email & SMS deep links.
# Prevents 403 Forbidden errors from internal development preview URLs.
# Format: https://your-production-domain.com or https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=""
APP_URL="MY_APP_URL"

# NAVER WORKS SMTP Settings for MES Dispatch Notifications
# Sender account: noworries004@jstech.kr (Host: smtp.worksmobile.com)
NAVERWORKS_SMTP_HOST="smtp.worksmobile.com"
NAVERWORKS_SMTP_PORT="587"
NAVERWORKS_SMTP_USER="noworries004@jstech.kr"
NAVERWORKS_SMTP_PASS=""

# Mobile SMS / Alimtalk Notification Settings (Solapi / CoolSMS)
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
SOLAPI_FROM_NUMBER="01000000000"
COOLSMS_API_KEY=""
COOLSMS_API_SECRET=""
COOLSMS_FROM_NUMBER="01000000000"
SMS_SENDER_NUMBER="01000000000"
